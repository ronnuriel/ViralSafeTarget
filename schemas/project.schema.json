{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viral-safe-target.example/schemas/project.schema.json",
  "title": "ViralSafeTarget research project",
  "type": "object",
  "required": [
    "schema_version",
    "project_type",
    "id",
    "display_name",
    "profiles",
    "workflow"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "project_type": {"const": "viral_safe_target_project"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "display_name": {"type": "string", "minLength": 1},
    "project_root": {"type": "string", "default": "."},
    "profiles": {
      "type": "object",
      "required": ["virus", "host", "nuclease"],
      "properties": {
        "virus": {"type": "string", "minLength": 1},
        "host": {"type": "string", "minLength": 1},
        "nuclease": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "workflow": {
      "type": "object",
      "required": ["ranking_config", "output_root"],
      "properties": {
        "ranking_config": {"type": "string", "minLength": 1},
        "output_root": {"type": "string", "minLength": 1},
        "minimum_strain_coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "balanced_top_per_gene": {"type": "integer", "minimum": 1},
        "global_top": {"type": "integer", "minimum": 0},
        "maximum_host_candidates": {"type": ["integer", "null"], "minimum": 1},
        "sequence_only": {"type": "boolean", "default": false},
        "evidence_discovery_enabled": {"type": "boolean", "default": false},
        "run_external_by_default": {"type": "boolean", "default": false}
      },
      "additionalProperties": false
    },
    "analysis": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean", "default": true},
        "output_dir": {"type": "string", "minLength": 1},
        "candidate_table": {"type": ["string", "null"]},
        "heldout_population_table": {"type": ["string", "null"]},
        "gene_ranking_table": {"type": ["string", "null"]},
        "indel_min_bp": {"type": "integer", "minimum": -100, "maximum": 0},
        "indel_max_bp": {"type": "integer", "minimum": 0, "maximum": 100},
        "default_panel_size": {"type": "integer", "minimum": 1},
        "focus_genes": {"type": "array", "items": {"type": "string"}},
        "case_study_notes": {"type": "array", "items": {"type": "string"}},
        "source_assertions": {"type": "array", "items": {"type": "object"}},
        "strategies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "size"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "size": {"type": "integer", "minimum": 1},
              "genes": {"type": "array", "items": {"type": "string"}},
              "categories": {"type": "array", "items": {"type": "string"}},
              "unique_genes": {"type": "boolean"},
              "unique_categories": {"type": "boolean"},
              "rationale": {"type": "string"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
