{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viralsafetarget.local/schemas/evidence_proposal.schema.json",
  "title": "ViralSafeTarget evidence proposal",
  "description": "A machine-proposed, source-linked claim that must remain pending until human review.",
  "type": "object",
  "required": [
    "proposal_id",
    "gene_name",
    "target_virus",
    "evidence_virus",
    "evidence_scope",
    "source_database",
    "source_identifier",
    "source_url",
    "source_title",
    "evidence_category",
    "experiment_type",
    "finding_summary",
    "proposed_essentiality_call",
    "proposed_evidence_strength",
    "quoted_evidence_span",
    "review_status"
  ],
  "properties": {
    "proposal_id": {"type": "string", "minLength": 1},
    "gene_name": {"type": "string", "minLength": 1},
    "target_virus": {"type": "string", "minLength": 1},
    "evidence_virus": {"type": "string"},
    "evidence_scope": {
      "enum": ["direct_target_virus", "ortholog", "mixed_or_other_virus", "unresolved"]
    },
    "source_database": {"enum": ["PubMed", "Europe PMC", "UniProt", "NCBI RefSeq"]},
    "source_identifier": {"type": "string", "minLength": 1},
    "source_url": {"type": "string", "format": "uri"},
    "source_title": {"type": "string"},
    "evidence_category": {"type": "string"},
    "experiment_type": {"type": "string"},
    "model_system": {"type": "string"},
    "measurement": {"type": "string"},
    "finding_summary": {"type": "string"},
    "evidence_direction": {"type": "string"},
    "proposed_essentiality_call": {"type": "string"},
    "proposed_essentiality_score": {"type": ["number", "string", "null"]},
    "proposed_evidence_strength": {"enum": ["direct", "supporting", "indirect", "unknown"]},
    "quoted_evidence_span": {"type": "string"},
    "confidence": {"enum": ["high", "medium", "low", "unknown"]},
    "review_status": {"enum": ["pending", "approved", "rejected"]},
    "reviewer": {"type": "string"},
    "review_date": {"type": "string"},
    "review_notes": {"type": "string"}
  },
  "additionalProperties": true
}
